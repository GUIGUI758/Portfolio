# En-têtes HTTP pour Cloudflare Pages (ce fichier n'est pas publié, Cloudflare le lit).
# Même protections que deploy/Caddyfile. Vérifier après mise en ligne : https://securityheaders.com

/*
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'none'; style-src 'self'; script-src 'self'; font-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Les polices ne changent jamais : cache navigateur 30 jours.
# (CSS et JS gardent le cache par défaut de Cloudflare, revalidé à chaque visite,
#  pour que tes modifications apparaissent tout de suite.)
/fonts/*
  Cache-Control: public, max-age=2592000

# Le CV : téléchargeable mais pas indexé par les moteurs de recherche
/CV_Mahe_LAURENT.pdf
  X-Robots-Tag: noindex

# L'adresse technique en .pages.dev ne doit pas concurrencer ton domaine dans Google
https://:project.pages.dev/*
  X-Robots-Tag: noindex
